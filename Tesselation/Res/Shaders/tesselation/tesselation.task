#version 460

#extension GL_EXT_mesh_shader : require
#extension GL_EXT_debug_printf : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

struct SharedData
{
	vec2 patch_coord;
	vec2 patch_size;
	vec4 grid;
};

struct Frustum {
	vec3 left;
	vec3 right;
	vec3 top;
	vec3 bottom;
	vec3 front;
	vec3 back;
	vec3 point_sides;
	vec3 point_front; vec3 point_back;
	vec3 side_vec;
	float azimuth;
	float zenith;
};


layout (binding = 0) uniform MatrixBuffer {
    mat4 model;
    mat4 view;
    mat4 proj;
	Frustum frustum;
} mat_buffer;

layout (push_constant, std430) uniform TessPC {
	layout (offset = 96) float u_scale;
};

taskPayloadSharedEXT SharedData payload;

void main()
{
	uint grid_count = uint(sqrt(float(gl_NumWorkGroups.z)));

	// Represents the coords in the XY plane. vec4(x1, y1, x2, y2)
	vec4 grid = vec4(-u_scale, -u_scale, u_scale, u_scale);
	vec2 range = vec2(grid.z - grid.x, grid.w - grid.y);

	if (grid_count > 1) {

		vec4 scaled_grid = grid * grid_count;

		vec4 bottom_left_grid = vec4(scaled_grid.xy, scaled_grid.xy + range);

		vec2 grid_coord = vec2(gl_WorkGroupID.z % grid_count, gl_WorkGroupID.z / grid_count);

		grid = vec4(
			bottom_left_grid.x + (grid_coord.x * range.x),
			bottom_left_grid.y + (grid_coord.y * range.y),
			bottom_left_grid.z + (grid_coord.x * range.x),
			bottom_left_grid.w + (grid_coord.y * range.y)
		);
	}

	uvec2 tess_num = gl_WorkGroupID.xy;
	uint thread_id = gl_LocalInvocationIndex;
	
	vec2 t = vec2(tess_num) / vec2(gl_NumWorkGroups.xy);
	payload.patch_coord = mix(grid.xy, grid.zw, t);
	payload.patch_size = (grid.zw - grid.xy) / gl_NumWorkGroups.xy;
	payload.grid = grid;

	if (subgroupElect()) {
		EmitMeshTasksEXT(1, 1, 1);
	}
}
